{
  "name": "lt700-firmware-tool",
  "version": "2.0.0",
  "private": true,
  "description": "Ecoaims LT700 production firmware tool",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:ui": "vite build",
    "package:win": "npm run build:ui && electron-builder --win nsis --x64",
    "package:mac": "npm run build:ui && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "esptool-js": "0.7.0",
    "spark-md5": "3.0.2"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.ecoaims.lt700firmwaretool",
    "productName": "LT700 Firmware Tool",
    "directories": { "output": "release" },
    "files": ["electron/**", "dist/**", "package.json"],
    "extraResources": [{ "from": "assets", "to": "assets" }],
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "artifactName": "LT700-Firmware-Tool-${version}-Windows-x64.${ext}" },
    "nsis": { "oneClick": false, "perMachine": true, "allowToChangeInstallationDirectory": true, "installerIcon": "build/icon.ico", "uninstallerIcon": "build/icon.ico", "include": "build/installer.nsh", "license": "assets/drivers/CP210x/SLAB_License_Agreement_VCP_Windows.txt" },
    "mac": { "target": ["dmg"], "icon": "build/icon.icns", "category": "public.app-category.utilities", "artifactName": "LT700-Firmware-Tool-${version}-macOS-arm64.${ext}" }
  }
}
